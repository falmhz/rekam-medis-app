<%- include('../partials/header') %>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  <div class="card-header">
    <div class="card-title">
      <span><%= isEdit ? '✏️ Ubah Data Pasien' : '➕ Pendaftaran Pasien Baru' %></span>
    </div>
    <a href="/pasien" class="btn btn-outline btn-sm">&larr; Kembali ke Daftar Pasien</a>
  </div>

  <div class="card-body">
    <form action="<%= isEdit ? '/pasien/' + pasien.id + '/edit' : '/pasien/tambah' %>" method="POST" id="formPasien">
      
      <!-- Nomor Rekam Medis (Otomatis) -->
      <div class="form-group">
        <label for="no_rm" class="form-label">Nomor Rekam Medis (No. RM)</label>
        <input 
          type="text" 
          id="no_rm" 
          name="no_rm" 
          class="form-control" 
          value="<%= pasien.no_rm %>" 
          readonly 
          style="background-color: #f1f5f9; font-weight: 700; color: var(--primary-dark);"
        >
        <span class="form-help">Nomor Rekam Medis dibuat otomatis oleh sistem.</span>
      </div>

      <div class="form-row">
        <!-- Nama Lengkap Pasien -->
        <div class="form-group">
          <label for="nama" class="form-label">Nama Lengkap Pasien <span class="required">*</span></label>
          <input 
            type="text" 
            id="nama" 
            name="nama" 
            class="form-control" 
            placeholder="Contoh: Budi Santoso" 
            value="<%= pasien.nama %>" 
            required
          >
        </div>

        <!-- Nomor Induk Kependudukan (NIK) -->
        <div class="form-group">
          <label for="nik" class="form-label">NIK (16 Digit Angka) <span class="required">*</span></label>
          <input 
            type="text" 
            id="nik" 
            name="nik" 
            class="form-control" 
            placeholder="Contoh: 3201011205850001" 
            maxlength="16" 
            value="<%= pasien.nik %>" 
            required
          >
          <span class="form-help">Wajib 16 digit angka sesuai KTP/KK.</span>
        </div>
      </div>

      <div class="form-row">
        <!-- Tanggal Lahir -->
        <div class="form-group">
          <label for="tgl_lahir" class="form-label">Tanggal Lahir <span class="required">*</span></label>
          <input 
            type="date" 
            id="tgl_lahir" 
            name="tgl_lahir" 
            class="form-control" 
            value="<%= pasien.tgl_lahir %>" 
            required
          >
        </div>

        <!-- Jenis Kelamin -->
        <div class="form-group">
          <label for="jenis_kelamin" class="form-label">Jenis Kelamin <span class="required">*</span></label>
          <select id="jenis_kelamin" name="jenis_kelamin" class="form-control" required>
            <option value="Laki-laki" <%= pasien.jenis_kelamin === 'Laki-laki' ? 'selected' : '' %>>Laki-laki</option>
            <option value="Perempuan" <%= pasien.jenis_kelamin === 'Perempuan' ? 'selected' : '' %>>Perempuan</option>
          </select>
        </div>

        <!-- Nomor HP / Kontak -->
        <div class="form-group">
          <label for="no_hp" class="form-label">Nomor Telepon / WhatsApp <span class="required">*</span></label>
          <input 
            type="tel" 
            id="no_hp" 
            name="no_hp" 
            class="form-control" 
            placeholder="Contoh: 081234567890" 
            value="<%= pasien.no_hp %>" 
            required
          >
        </div>
      </div>

      <!-- Alamat Lengkap -->
      <div class="form-group">
        <label for="alamat" class="form-label">Alamat Lengkap Tempat Tinggal <span class="required">*</span></label>
        <textarea 
          id="alamat" 
          name="alamat" 
          class="form-control" 
          rows="3" 
          placeholder="Masukkan nama jalan, nomor rumah, RT/RW, kelurahan, dan kota..." 
          required
        ><%= pasien.alamat %></textarea>
      </div>

      <!-- Tombol Aksi -->
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          <%= isEdit ? '💾 Simpan Perubahan Data' : '✅ Daftarkan Pasien Baru' %>
        </button>
        <a href="/pasien" class="btn btn-outline">Batal</a>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>
