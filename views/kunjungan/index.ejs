<%- include('../partials/header') %>

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <span>📋 Antrean & Daftar Kunjungan Pasien</span>
    </div>
    <% if (currentUser.role === 'petugas' || currentUser.role === 'admin') { %>
      <a href="/kunjungan/tambah" class="btn btn-primary">
        + Buat Kunjungan Baru
      </a>
    <% } %>
  </div>

  <div class="card-body">
    <!-- Filter Status & Tanggal -->
    <form method="GET" action="/kunjungan" class="filter-bar" style="background-color: #f8fafc; padding: 14px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
      
      <!-- Filter Status -->
      <div style="display: flex; align-items: center; gap: 8px;">
        <label for="status" style="font-size: 13px; font-weight: 600;">Status:</label>
        <select name="status" id="status" class="form-control" style="width: auto; min-width: 140px;">
          <option value="Semua" <%= statusFilter === 'Semua' ? 'selected' : '' %>>Semua Status</option>
          <option value="Menunggu" <%= statusFilter === 'Menunggu' ? 'selected' : '' %>>Menunggu</option>
          <option value="Diperiksa" <%= statusFilter === 'Diperiksa' ? 'selected' : '' %>>Diperiksa</option>
          <option value="Selesai" <%= statusFilter === 'Selesai' ? 'selected' : '' %>>Selesai</option>
        </select>
      </div>

      <!-- Filter Tanggal -->
      <div style="display: flex; align-items: center; gap: 8px;">
        <label for="tanggal" style="font-size: 13px; font-weight: 600;">Tanggal:</label>
        <input 
          type="date" 
          name="tanggal" 
          id="tanggal" 
          class="form-control" 
          style="width: auto;" 
          value="<%= tanggalFilter || '' %>"
        >
      </div>

      <!-- Filter Khusus Dokter: Hanya Pasien Milik Saya -->
      <% if (currentUser.role === 'dokter') { %>
        <div style="display: flex; align-items: center; gap: 8px;">
          <label style="font-size: 13px; font-weight: 600; cursor: pointer;">
            <input 
              type="checkbox" 
              name="milik_saya" 
              value="1" 
              <%= dokterFilter === '1' ? 'checked' : '' %>
              onchange="this.form.submit()"
            >
            Hanya Pasien Saya
          </label>
        </div>
      <% } %>

      <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      <a href="/kunjungan" class="btn btn-outline btn-sm">Reset</a>

      <!-- Pencarian Langsung di Tabel -->
      <div class="search-input-wrapper" style="margin-left: auto;">
        <input 
          type="text" 
          class="form-control search-input" 
          placeholder="Ketik untuk memfilter tabel..." 
          data-table-filter="antreanTable"
        >
      </div>
    </form>

    <!-- Tabel Daftar Antrean Kunjungan -->
    <div class="table-responsive">
      <table class="data-table" id="antreanTable">
        <thead>
          <tr>
            <th>Tanggal</th>
            <th>No. RM</th>
            <th>Nama Pasien</th>
            <th>Dokter</th>
            <th>Keluhan Utama</th>
            <th class="text-center">Status</th>
            <th class="text-center" style="min-width: 140px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (kunjunganList && kunjunganList.length > 0) { %>
            <% kunjunganList.forEach(k => { %>
              <tr>
                <td>
                  <%= k.tanggal instanceof Date ? k.tanggal.toLocaleDateString('id-ID') : k.tanggal %>
                </td>
                <td><strong><%= k.no_rm %></strong></td>
                <td>
                  <a href="/pasien/<%= k.pasien_id %>" style="font-weight: 600; color: var(--primary); text-decoration: none;">
                    <%= k.nama_pasien %>
                  </a>
                </td>
                <td><%= k.nama_dokter %></td>
                <td style="max-width: 250px;"><%= k.keluhan %></td>
                <td class="text-center">
                  <span class="badge badge-<%= k.status.toLowerCase() %>">
                    <%= k.status %>
                  </span>
                </td>
                <td class="text-center">
                  <div style="display: inline-flex; gap: 4px;">
                    <!-- Aksi Dokter -->
                    <% if (currentUser.role === 'dokter') { %>
                      <% if (k.status === 'Menunggu' || k.status === 'Diperiksa') { %>
                        <a href="/pemeriksaan/<%= k.id %>" class="btn btn-primary btn-sm">
                          🩺 Periksa
                        </a>
                      <% } else { %>
                        <a href="/pemeriksaan/<%= k.id %>" class="btn btn-outline btn-sm">
                          Detail RM
                        </a>
                      <% } %>
                    <% } else { %>
                      <a href="/pasien/<%= k.pasien_id %>" class="btn btn-outline btn-sm" title="Lihat Rekam Medis">
                        Riwayat
                      </a>
                    <% } %>

                    <!-- Aksi Petugas/Admin (Hapus dari antrean jika belum selesai) -->
                    <% if ((currentUser.role === 'petugas' || currentUser.role === 'admin') && k.status !== 'Selesai') { %>
                      <form action="/kunjungan/<%= k.id %>/hapus" method="POST" style="display: inline;" data-confirm="Apakah Anda yakin ingin membatalkan/menghapus kunjungan ini dari antrean?">
                        <button type="submit" class="btn btn-danger btn-sm" title="Batalkan Kunjungan">
                          Batal
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr class="no-filter">
              <td colspan="7" class="text-center" style="padding: 30px; color: var(--text-muted);">
                Tidak ada data kunjungan yang sesuai dengan filter.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
