<%- include('../partials/header') %>

<div class="card" style="max-width: 650px; margin: 0 auto;">
  <div class="card-header">
    <div class="card-title">
      <span><%= isEdit ? '✏️ Ubah Pengguna' : '➕ Tambah Pengguna Baru' %></span>
    </div>
    <a href="/user" class="btn btn-outline btn-sm">&larr; Kembali ke Daftar Pengguna</a>
  </div>

  <div class="card-body">
    <form action="<%= isEdit ? '/user/' + userItem.id + '/edit' : '/user/tambah' %>" method="POST">
      
      <!-- Nama Lengkap -->
      <div class="form-group">
        <label for="nama" class="form-label">Nama Lengkap & Gelar <span class="required">*</span></label>
        <input 
          type="text" 
          id="nama" 
          name="nama" 
          class="form-control" 
          placeholder="Contoh: dr. Budi Santoso, Sp.PD atau Siti Rahma (Petugas)" 
          value="<%= userItem.nama %>" 
          required 
          autofocus
        >
      </div>

      <!-- Username -->
      <div class="form-group">
        <label for="username" class="form-label">Nama Pengguna (Username) <span class="required">*</span></label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          class="form-control" 
          placeholder="Contoh: drbudi atau budi12" 
          value="<%= userItem.username %>" 
          <%= isEdit ? 'readonly style="background-color: #f1f5f9;"' : 'required' %>
        >
        <% if (isEdit) { %>
          <span class="form-help">Username tidak dapat diubah setelah dibuat.</span>
        <% } %>
      </div>

      <!-- Password (Hanya saat tambah user baru) -->
      <% if (!isEdit) { %>
        <div class="form-group">
          <label for="password" class="form-label">Kata Sandi (Password) <span class="required">*</span></label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            placeholder="Minimal 6 karakter" 
            minlength="6" 
            required
          >
        </div>
      <% } %>

      <!-- Role Pengguna -->
      <div class="form-group">
        <label for="role" class="form-label">Peran (Role) Pengguna <span class="required">*</span></label>
        <select id="role" name="role" class="form-control" required>
          <option value="petugas" <%= userItem.role === 'petugas' ? 'selected' : '' %>>Petugas Pendaftaran</option>
          <option value="dokter" <%= userItem.role === 'dokter' ? 'selected' : '' %>>Dokter</option>
          <option value="admin" <%= userItem.role === 'admin' ? 'selected' : '' %>>Administrator</option>
        </select>
        <span class="form-help">Pilih peran sesuai tanggung jawab dan hak akses pengguna di klinik.</span>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          <%= isEdit ? '💾 Simpan Perubahan Pengguna' : '✅ Daftarkan Pengguna Baru' %>
        </button>
        <a href="/user" class="btn btn-outline">Batal</a>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>
