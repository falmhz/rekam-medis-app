<%- include('../partials/header') %>

<div class="error-container">
  <div class="error-code" style="color: var(--danger);">500</div>
  <h2 class="error-title">Terjadi Kesalahan Server</h2>
  <p class="error-desc">
    Terjadi kesalahan internal pada server saat memproses permintaan Anda. Silakan coba sesaat lagi atau hubungi administrator sistem.
  </p>
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 12px; border-radius: var(--radius-sm); font-size: 13px; margin-bottom: 20px; text-align: left; overflow-x: auto;">
      <strong>Pesan Kesalahan:</strong> <code><%= errorMessage %></code>
    </div>
  <% } %>
  <div style="display: flex; justify-content: center; gap: 12px;">
    <a href="/dashboard" class="btn btn-primary">Kembali ke Dashboard</a>
    <a href="javascript:location.reload()" class="btn btn-outline">Muat Ulang Halaman</a>
  </div>
</div>

<%- include('../partials/footer') %>
